LC_API=http://localhost:13491/api/v1
PM_USER=lattice
PM_PASS=
TABLE_ID=pm
WORKSPACE_ID=<workspace-uuid>
LLM_PROVIDER=claude
# Programmatic gate before a ticket can reach `merged`. Runs from the story
# worktree; a non-zero exit sends the ticket to `debugging` instead. Unset
# means no gate -- `merged` then only reflects what the LLM reported.
HIVE_VERIFY_CMD=
# Required only when cron should resume a Codex chat with monitor reports.
MONITOR_CODEX_SESSION_ID=
# PROJECT_DIR=/abs/path/to/project
# SKILLS_DIR=/abs/path/to/project/.agent-skills
# LLM_PROJECT_DIR=/abs/path/to/project
# CLAUDE_MODEL=sonnet
# CODEX_MODEL=gpt-5.6-codex
